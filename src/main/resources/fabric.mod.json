{
  "schemaVersion": 1,
  "id": "signalindustries",
  "version": "${version}",
  "name": "Signal Industries",
  "icon": "icon128.png",
  "description": "A stylized technomagical mod centered around a special power source, cool gadgets included.",
  "authors": [
    "sunsetsatellite"
  ],
  "contact": {
    "sources": "https://github.com/MartinSVK12/signalindustries",
    "issues": "https://github.com/MartinSVK12/signalindustries/issues"
  },
  "license": "GNU LGPLv3",
  "contributors": [
    "beatrice",
    "theRandomHat",
    "TheMidford",
    "watermelonMojito",
    "felix170905",
    "mzov",
    "azurelmao",
    "toufouMaster",
    "samuelDeboni",
    "useless",
    "sillydot",
    "bigjango13"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "sunsetsatellite.signalindustries.SignalIndustries"
    ],
		"client": [
			"sunsetsatellite.signalindustries.SignalIndustriesClient"
		],
		"server": [
			"sunsetsatellite.signalindustries.SignalIndustriesServer"
		]
	},
  "mixins": [
    "signalindustries.mixins.json"
  ],
  "depends": {
    "minecraft": "~8.0-beta.2",
    "fabricloader": ">=${loader}",
    "catalyst-core": ">=${core}",
    "catalyst-fluids": ">=${fluids}",
    "catalyst-multiblocks": ">=${multiblocks}",
    "catalyst-energy": ">=${energy}",
    "catalyst-multipart": ">=${multipart}",
		"catalyst-screens": ">=${screens}",
    "halplibe": ">=${halplibe}"
  },
  "suggests": {
    "vintage-questing": "*",
    "btwaila": "*",
    "tmb": "*"
  }
}
